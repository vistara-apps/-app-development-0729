# Diginer Environment Configuration

# API Configuration
VITE_API_BASE_URL=https://api.diginer.app
VITE_ENVIRONMENT=production

# Wallet & Blockchain Configuration
VITE_WALLET_CONNECT_PROJECT_ID=9f4bd472c01ba49282b42e5e1874c2af
VITE_CHAIN_ID=8453
VITE_CHAIN_NAME=Base

# Payment Configuration
VITE_PAYMENT_API_URL=https://payments.vistara.dev
VITE_MICRO_TRANSACTION_AMOUNT=0.001

# Farcaster Configuration
VITE_FARCASTER_HUB_URL=https://hub.farcaster.xyz
VITE_FARCASTER_APP_FID=your_app_fid_here

# TikTok Integration (if available)
VITE_TIKTOK_API_KEY=your_tiktok_api_key_here
VITE_TIKTOK_API_SECRET=your_tiktok_api_secret_here

# Analytics & Monitoring
VITE_ANALYTICS_ID=your_analytics_id_here
VITE_SENTRY_DSN=your_sentry_dsn_here

# Feature Flags
VITE_ENABLE_TIKTOK_INTEGRATION=true
VITE_ENABLE_FARCASTER_FRAMES=true
VITE_ENABLE_PAYMENT_FEATURES=true
VITE_ENABLE_ANALYTICS=true

# Development Configuration
VITE_DEBUG_MODE=false
VITE_MOCK_API_RESPONSES=false
